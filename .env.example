# EmuDesk coordination server — environment variables (copy to .env)
# Used by docker-compose / Railway / any container platform.

# HTTP listen port (Railway injects PORT automatically).
PORT=5876

# Address to bind.
BIND=0.0.0.0

# Optional bearer token required for POST /api/register.
# Leave empty for local/dev; set a strong random value in production.
API_TOKEN=

# Directory where device registrations are persisted (JSON files).
SERVER_DATA_DIR=./emudesk-server-data

# Rust log level.
RUST_LOG=info